<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<table>
  <thead>
    <tr>
      <th>
        <% current_order = (params[:sort_col].to_i == 0 ? params[:sort_order].to_i : 0) %>
        <% new_order = current_order == 0 ? 1 : 0 %>
        <%= link_to movies_path(sort_col: 0, sort_order: new_order), style: (params[:sort_col].to_i == 0 ? (params[:sort_order].to_i == 0 ? "color: blue;" : "color: red;") : "") do %>
          Title <%= params[:sort_col].to_i == 0 ? (params[:sort_order].to_i == 0 ? '▲' : '▼') : '' %>
        <% end %>
      </th>
      <th>
        <% current_order = (params[:sort_col].to_i == 1 ? params[:sort_order].to_i : 0) %>
        <% new_order = current_order == 0 ? 1 : 0 %>
        <%= link_to "Rating", movies_path(sort_col: 1, sort_order: new_order) %>
      </th>
      <th>
        <% current_order = (params[:sort_col].to_i == 2 ? params[:sort_order].to_i : 0) %>
        <% new_order = current_order == 0 ? 1 : 0 %>
        <%= link_to "Release Date", movies_path(sort_col: 2, sort_order: new_order) %>
      </th>
    </tr>
  </thead>

  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= link_to movie.title, movie %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date.strftime("%Y-%m-%d") %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= button_to "New movie", new_movie_path" %>
